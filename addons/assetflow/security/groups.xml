<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Security Category -->
        <record id="module_category_assetflow" model="ir.module.category">
            <field name="name">AssetFlow</field>
            <field name="description">Enterprise Asset &amp; Resource Management System.</field>
            <field name="sequence">10</field>
        </record>

        <!-- 4. Employee Group -->
        <record id="group_employee" model="res.groups">
            <field name="name">Employee</field>
            <field name="category_id" ref="module_category_assetflow"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Can view assigned assets, request bookings, raise maintenance requests, and view personal notifications.</field>
        </record>

        <!-- 3. Department Head Group -->
        <record id="group_department_head" model="res.groups">
            <field name="name">Department Head</field>
            <field name="category_id" ref="module_category_assetflow"/>
            <field name="implied_ids" eval="[(4, ref('group_employee'))]"/>
            <field name="comment">Can view department assets, approve bookings, raise maintenance requests, and participate in audits.</field>
        </record>

        <!-- 2. Asset Manager Group -->
        <record id="group_asset_manager" model="res.groups">
            <field name="name">Asset Manager</field>
            <field name="category_id" ref="module_category_assetflow"/>
            <field name="implied_ids" eval="[(4, ref('group_employee'))]"/>
            <field name="comment">Can register assets, allocate assets, approve maintenance, manage bookings, and view reports.</field>
        </record>

        <!-- 1. AssetFlow Administrator Group -->
        <record id="group_assetflow_admin" model="res.groups">
            <field name="name">AssetFlow Administrator</field>
            <field name="category_id" ref="module_category_assetflow"/>
            <field name="implied_ids" eval="[(4, ref('group_asset_manager')), (4, ref('group_department_head'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="comment">Full access to all AssetFlow features.</field>
        </record>
    </data>
</odoo>
