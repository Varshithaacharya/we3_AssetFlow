<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ==================== ASSET ALLOCATION RULES ==================== -->
        <record id="rule_assetflow_allocation_employee" model="ir.rule">
            <field name="name">Employee Allocations</field>
            <field name="model_id" ref="model_assetflow_allocation"/>
            <field name="domain_force">['|', ('employee_id.user_id', '=', user.id), '&amp;', ('department_id', '!=', False), ('department_id', '=', user.employee_id.department_id.id)]</field>
            <field name="groups" eval="[(4, ref('group_assetflow_employee'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <record id="rule_assetflow_allocation_dept_head" model="ir.rule">
            <field name="name">Department Head Allocations</field>
            <field name="model_id" ref="model_assetflow_allocation"/>
            <field name="domain_force">['|', ('employee_id.department_id', '=', user.employee_id.department_id.id), ('department_id', '=', user.employee_id.department_id.id)]</field>
            <field name="groups" eval="[(4, ref('group_assetflow_dept_head'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <record id="rule_assetflow_allocation_manager" model="ir.rule">
            <field name="name">Asset Manager Allocations</field>
            <field name="model_id" ref="model_assetflow_allocation"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_asset_manager')), (4, ref('group_assetflow_admin'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>


        <!-- ==================== RESOURCE BOOKING RULES ==================== -->
        <record id="rule_assetflow_booking_employee" model="ir.rule">
            <field name="name">Employee Bookings</field>
            <field name="model_id" ref="model_assetflow_booking"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_assetflow_employee'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <record id="rule_assetflow_booking_dept_head" model="ir.rule">
            <field name="name">Department Head Bookings</field>
            <field name="model_id" ref="model_assetflow_booking"/>
            <field name="domain_force">[('employee_id.department_id', '=', user.employee_id.department_id.id)]</field>
            <field name="groups" eval="[(4, ref('group_assetflow_dept_head'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <record id="rule_assetflow_booking_manager" model="ir.rule">
            <field name="name">Asset Manager Bookings</field>
            <field name="model_id" ref="model_assetflow_booking"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_asset_manager')), (4, ref('group_assetflow_admin'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>


        <!-- ==================== MAINTENANCE RULES ==================== -->
        <record id="rule_assetflow_maintenance_employee" model="ir.rule">
            <field name="name">Employee Maintenance Requests</field>
            <field name="model_id" ref="model_assetflow_maintenance"/>
            <field name="domain_force">[('reporter_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_assetflow_employee'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <record id="rule_assetflow_maintenance_dept_head" model="ir.rule">
            <field name="name">Department Head Maintenance Requests</field>
            <field name="model_id" ref="model_assetflow_maintenance"/>
            <field name="domain_force">[('reporter_id.department_id', '=', user.employee_id.department_id.id)]</field>
            <field name="groups" eval="[(4, ref('group_assetflow_dept_head'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <record id="rule_assetflow_maintenance_manager" model="ir.rule">
            <field name="name">Asset Manager Maintenance Requests</field>
            <field name="model_id" ref="model_assetflow_maintenance"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_asset_manager')), (4, ref('group_assetflow_admin'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>


        <!-- ==================== ASSET RULES ==================== -->
        <record id="rule_assetflow_asset_employee" model="ir.rule">
            <field name="name">Employee Assets</field>
            <field name="model_id" ref="model_assetflow_asset"/>
            <field name="domain_force">['|', ('is_bookable', '=', True), ('allocation_ids.employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_assetflow_employee'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <record id="rule_assetflow_asset_dept_head" model="ir.rule">
            <field name="name">Department Head Assets</field>
            <field name="model_id" ref="model_assetflow_asset"/>
            <field name="domain_force">['|', ('is_bookable', '=', True), '|', ('allocation_ids.employee_id.department_id', '=', user.employee_id.department_id.id), ('allocation_ids.department_id', '=', user.employee_id.department_id.id)]</field>
            <field name="groups" eval="[(4, ref('group_assetflow_dept_head'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <record id="rule_assetflow_asset_manager" model="ir.rule">
            <field name="name">Asset Manager Assets</field>
            <field name="model_id" ref="model_assetflow_asset"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_asset_manager')), (4, ref('group_assetflow_admin'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

    </data>
</odoo>
