<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="sequence_asset_asset" model="ir.sequence">
            <field name="name">Asset Tag Sequence</field>
            <field name="code">asset.asset.sequence</field>
            <field name="prefix">AF-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="sequence_asset_audit" model="ir.sequence">
            <field name="name">Asset Audit Sequence</field>
            <field name="code">asset.audit.sequence</field>
            <field name="prefix">AUD-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
