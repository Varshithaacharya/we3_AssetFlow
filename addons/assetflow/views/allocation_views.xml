<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View -->
    <record id="view_assetflow_allocation_tree" model="ir.ui.view">
        <field name="name">asset.allocation.tree</field>
        <field name="model">asset.allocation</field>
        <field name="arch" type="xml">
            <tree string="Asset Allocations" decoration-danger="is_overdue == True">
                <field name="asset_id"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="allocated_by_id"/>
                <field name="allocation_date"/>
                <field name="expected_return_date"/>
                <field name="actual_return_date"/>
                <field name="state" widget="badge" 
                       decoration-info="state in ('requested', 'transfer_requested')"
                       decoration-success="state == 'allocated'"
                       decoration-muted="state in ('returned', 'cancelled')"/>
                <field name="is_overdue" column_invisible="1"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_assetflow_allocation_form" model="ir.ui.view">
        <field name="name">asset.allocation.form</field>
        <field name="model">asset.allocation</field>
        <field name="arch" type="xml">
            <form string="Asset Allocation">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="requested,allocated,returned" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <group>
                        <group string="Allocation Information">
                            <field name="asset_id"/>
                            <field name="employee_id"/>
                            <field name="department_id"/>
                            <field name="allocated_by_id"/>
                        </group>
                        <group string="Dates">
                            <field name="allocation_date"/>
                            <field name="expected_return_date"/>
                            <field name="actual_return_date"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="check_in_notes" nolabel="1" placeholder="Enter check-in notes here..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_assetflow_allocation_search" model="ir.ui.view">
        <field name="name">asset.allocation.search</field>
        <field name="model">asset.allocation</field>
        <field name="arch" type="xml">
            <search string="Search Allocations">
                <field name="asset_id"/>
                <field name="employee_id"/>
                <field name="department_id"/>

                <filter string="Allocated" name="allocated" domain="[('state', '=', 'allocated')]"/>
                <filter string="Returned" name="returned" domain="[('state', '=', 'returned')]"/>
                <separator/>
                <filter string="Overdue" name="overdue" domain="[('is_overdue', '=', True)]"/>

                <group expand="0" string="Group By">
                    <filter string="Department" name="group_department" context="{'group_by':'department_id'}"/>
                    <filter string="Employee" name="group_employee" context="{'group_by':'employee_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_assetflow_allocation" model="ir.actions.act_window">
        <field name="name">Asset Allocations</field>
        <field name="res_model">asset.allocation</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_assetflow_allocation_search"/>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            Allocate an asset
          </p>
          <p>
            Track which assets are assigned to which employees or departments, and monitor their return dates.
          </p>
        </field>
    </record>

    <!-- Force Action to use specific views -->
    <record id="action_assetflow_allocation_tree_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_assetflow_allocation_tree"/>
        <field name="act_window_id" ref="action_assetflow_allocation"/>
    </record>

    <record id="action_assetflow_allocation_form_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_assetflow_allocation_form"/>
        <field name="act_window_id" ref="action_assetflow_allocation"/>
    </record>

</odoo>
