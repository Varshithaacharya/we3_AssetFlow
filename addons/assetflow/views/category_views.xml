<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View -->
    <record id="view_asset_category_tree" model="ir.ui.view">
        <field name="name">assetflow.category.tree</field>
        <field name="model">assetflow.category</field>
        <field name="arch" type="xml">
            <tree string="Asset Categories">
                <field name="name"/>
                <field name="parent_id"/>
                <field name="warranty_required"/>
                <field name="warranty_period"/>
                <field name="active" widget="boolean_toggle" string="Status"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_asset_category_form" model="ir.ui.view">
        <field name="name">assetflow.category.form</field>
        <field name="model">assetflow.category</field>
        <field name="arch" type="xml">
            <form string="Asset Category">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="parent_id"/>
                        </group>
                        <group>
                            <field name="warranty_required"/>
                            <field name="warranty_period" invisible="warranty_required == False"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_asset_category_search" model="ir.ui.view">
        <field name="name">assetflow.category.search</field>
        <field name="model">assetflow.category</field>
        <field name="arch" type="xml">
            <search string="Search Asset Categories">
                <field name="name" string="Category Name"/>
                
                <filter string="Warranty Required" name="warranty_required" domain="[('warranty_required', '=', True)]"/>
                <separator/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
                
                <group expand="0" string="Group By">
                    <filter string="Parent Category" name="group_parent" context="{'group_by':'parent_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_asset_category" model="ir.actions.act_window">
        <field name="name">Asset Categories</field>
        <field name="res_model">assetflow.category</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_asset_category_search"/>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            Create a new asset category
          </p>
          <p>
            Organize your assets by creating categories like Electronics, Furniture, or Vehicles.
          </p>
        </field>
    </record>

    <!-- Force Action to use specific views -->
    <record id="action_asset_category_tree_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_asset_category_tree"/>
        <field name="act_window_id" ref="action_asset_category"/>
    </record>

    <record id="action_asset_category_form_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_asset_category_form"/>
        <field name="act_window_id" ref="action_asset_category"/>
    </record>

</odoo>
