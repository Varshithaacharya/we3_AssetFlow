<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Reset Password Page -->
    <template id="assetflow_reset_password" name="AssetFlow Reset Password">
        <t t-call="web.layout">
            <t t-set="title">AssetFlow - Reset Password</t>
            <div class="container-fluid vh-100 d-flex justify-content-center align-items-center bg-light">
                
                <div class="card shadow-sm rounded-4 border-0 w-100" style="max-width: 480px;">
                    <div class="card-body p-5">
                        
                        <!-- Header -->
                        <div class="text-center mb-4">
                            <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex p-3 mb-3">
                                <i class="fa fa-shield fa-2x text-primary"></i>
                            </div>
                            <h2 class="fw-bold mb-2">Create New Password</h2>
                            <p class="text-muted">Please set a strong password.</p>
                        </div>
                        
                        <form role="form" action="/web/reset_password/confirm" method="post">
                            <!-- TODO: Integrate token validation and password reset logic here -->
                            
                            <div class="mb-4">
                                <label for="password" class="form-label fw-semibold">New Password</label>
                                <input type="password" name="password" id="password" class="form-control form-control-lg rounded-3" required="required" autofocus="autofocus" placeholder="Enter new password"/>
                            </div>
                            
                            <div class="mb-4">
                                <label for="confirm_password" class="form-label fw-semibold">Confirm Password</label>
                                <input type="password" name="confirm_password" id="confirm_password" class="form-control form-control-lg rounded-3" required="required" placeholder="Re-enter new password"/>
                            </div>

                            <!-- Password Strength Indicator (Static Placeholder UI) -->
                            <div class="mb-4">
                                <div class="d-flex justify-content-between mb-2 small fw-semibold">
                                    <span class="text-muted">Password Strength</span>
                                    <span class="text-warning">Medium</span>
                                </div>
                                <div class="progress" style="height: 6px;">
                                    <div class="progress-bar bg-warning rounded-pill" role="progressbar" style="width: 50%" aria-valuenow="50" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                            </div>
                            
                            <!-- Password Requirements Checklist -->
                            <div class="mb-4 bg-light rounded-3 p-4 small text-muted border">
                                <p class="fw-bold text-dark mb-3">Password Requirements</p>
                                <ul class="list-unstyled mb-0 ms-2">
                                    <li class="mb-2"><i class="fa fa-check-circle text-success me-2"></i>Minimum 8 characters</li>
                                    <li class="mb-2"><i class="fa fa-check-circle text-success me-2"></i>One uppercase</li>
                                    <li class="mb-2"><i class="fa fa-circle-thin me-2"></i>One number</li>
                                    <li><i class="fa fa-circle-thin me-2"></i>One special character</li>
                                </ul>
                            </div>
                            
                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-primary btn-lg rounded-3 fw-bold shadow-sm">Reset Password</button>
                            </div>
                        </form>
                    </div>
                </div>

            </div>
        </t>
    </template>

    <!-- Success Confirmation Page -->
    <template id="assetflow_reset_password_success" name="AssetFlow Reset Success">
        <t t-call="web.layout">
            <t t-set="title">AssetFlow - Password Updated</t>
            <div class="container-fluid vh-100 d-flex justify-content-center align-items-center bg-light">
                
                <div class="card shadow-sm rounded-4 border-0 w-100 text-center p-4" style="max-width: 480px;">
                    <div class="card-body p-5">
                        <div class="mb-4">
                            <i class="fa fa-check-circle text-success" style="font-size: 5rem;"></i>
                        </div>
                        <h2 class="fw-bold mb-3 text-dark">Password Updated Successfully</h2>
                        <p class="text-muted mb-5">Your password has been reset successfully. You can now log in using your new credentials.</p>
                        
                        <a href="/web/login" class="btn btn-primary btn-lg rounded-3 fw-bold w-100 py-3 shadow-sm">Return to Login</a>
                    </div>
                </div>

            </div>
        </t>
    </template>
</odoo>
