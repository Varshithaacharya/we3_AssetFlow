<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit hr.employee form to add AssetFlow role field -->
    <record id="view_assetflow_employee_form" model="ir.ui.view">
        <field name="name">assetflow.employee.form</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="role"/>
            </field>
        </field>
    </record>

    <!-- Inherit hr.employee list to add role column -->
    <record id="view_assetflow_employee_tree" model="ir.ui.view">
        <field name="name">assetflow.employee.tree</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="role"/>
            </field>
        </field>
    </record>

    <!-- Window Action — points to standard hr.employee views (extended above) -->
    <record id="action_assetflow_employee" model="ir.actions.act_window">
        <field name="name">Employee Directory</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            Add a new employee
          </p>
          <p>
            Manage the employee directory and assign AssetFlow roles such as Department Head or Asset Manager.
          </p>
        </field>
    </record>

</odoo>
