<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="assetflow_forgot_password" name="AssetFlow Forgot Password">
        <t t-call="web.layout">
            <t t-set="title">AssetFlow - Forgot Password</t>
            <div class="container-fluid vh-100 d-flex justify-content-center align-items-center bg-light">
                
                <div class="card shadow-sm rounded-4 border-0 w-100" style="max-width: 480px;">
                    <div class="card-body p-5">
                        
                        <!-- Header -->
                        <div class="text-center mb-4">
                            <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex p-3 mb-3">
                                <i class="fa fa-lock fa-2x text-primary"></i>
                            </div>
                            <h2 class="fw-bold mb-2">Forgot your password?</h2>
                            <p class="text-muted">Enter your registered email address.</p>
                        </div>
                        
                        <!-- Success State Placeholder (Condition to be driven by backend) -->
                        <t t-if="message_sent">
                            <div class="alert alert-success rounded-3 border-0 bg-success-light p-4 mb-0 text-center">
                                <i class="fa fa-check-circle fa-3x mb-3 text-success"></i>
                                <h5 class="fw-bold mb-2 text-dark">Password reset link has been sent.</h5>
                                <p class="mb-2 text-muted">Please check your email.</p>
                                <small class="text-muted opacity-75">If you don't receive it within a few minutes, check your spam folder.</small>
                            </div>
                        </t>

                        <!-- Form State -->
                        <t t-else="">
                            <form role="form" action="/web/reset_password" method="post">
                                <!-- TODO: Implement backend password reset dispatch logic here -->
                                
                                <div class="mb-4">
                                    <label for="login" class="form-label fw-semibold">Company Email</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-white text-muted rounded-start-3"><i class="fa fa-envelope"></i></span>
                                        <input type="email" name="login" id="login" class="form-control form-control-lg rounded-end-3" required="required" autofocus="autofocus" placeholder="name@company.com"/>
                                    </div>
                                </div>
                                
                                <div class="d-grid gap-2 mb-4">
                                    <button type="submit" class="btn btn-primary btn-lg rounded-3 fw-bold shadow-sm">Send Reset Link</button>
                                </div>
                            </form>
                        </t>

                        <!-- Footer Link -->
                        <div class="text-center mt-3 pt-3 border-top">
                            <a href="/web/login" class="text-decoration-none text-muted fw-semibold hover-primary">
                                <i class="fa fa-arrow-left me-2"></i>Back to Login
                            </a>
                        </div>

                    </div>
                </div>

            </div>
        </t>
    </template>
</odoo>
