<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ======================================================================= -->
    <!-- PART A: ASSET DIRECTORY & REGISTRATION                                  -->
    <!-- ======================================================================= -->

    <!-- Window Action: Asset Directory -->
    <record id="action_assetflow_asset" model="ir.actions.act_window">
        <field name="name">Asset Directory</field>
        <field name="res_model">assetflow.asset</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register your first asset!
            </p>
            <p>
                Manage physical equipment, software licenses, or office furniture.
            </p>
        </field>
    </record>

    <!-- Tree/List View: Asset Directory -->
    <record id="view_assetflow_asset_tree" model="ir.ui.view">
        <field name="name">assetflow.asset.tree</field>
        <field name="model">assetflow.asset</field>
        <field name="arch" type="xml">
            <!-- decoration-danger triggers red text for lost assets -->
            <tree decoration-danger="state == 'lost'">
                <field name="asset_tag"/>
                <field name="name"/>
                <field name="category_id"/>
                <!-- Status widget styled as a badge -->
                <field name="state" widget="badge" 
                       decoration-success="state == 'available'" 
                       decoration-info="state == 'allocated'" 
                       decoration-warning="state in ('reserved', 'maintenance')" 
                       decoration-danger="state == 'lost'" 
                       decoration-muted="state in ('retired', 'disposed')"/>
                <field name="location"/>
                <field name="department_id"/>
                <field name="condition"/>
            </tree>
        </field>
    </record>

    <!-- Form View: Asset Registration -->
    <record id="view_assetflow_asset_form" model="ir.ui.view">
        <field name="name">assetflow.asset.form</field>
        <field name="model">assetflow.asset</field>
        <field name="arch" type="xml">
            <form string="Asset Registration">
                <!-- Header with statusbar widget and transition buttons -->
                <header>
                    <!-- Documented Transitions:
                         1. Available <-> Maintenance (buttons active based on state)
                         2. Allocated -> Available (Release button active) -->
                    <button name="action_send_to_maintenance" 
                            string="Send to Maintenance" 
                            type="object" 
                            class="btn-secondary" 
                            invisible="state != 'available'"/>
                    <button name="action_set_to_available" 
                            string="Set to Available" 
                            type="object" 
                            class="btn-primary" 
                            invisible="state != 'maintenance'"/>
                    <button name="action_release" 
                            string="Release Asset" 
                            type="object" 
                            class="btn-secondary" 
                            invisible="state != 'allocated'"/>
                            
                    <!-- Statusbar widget showing the lifecycle states -->
                    <field name="state" widget="statusbar" 
                           statusbar_visible="available,allocated,reserved,maintenance,lost,retired,disposed"/>
                </header>
                
                <sheet>
                    <!-- Image Avatar widget on the top right -->
                    <field name="photo_or_document" widget="image" class="oe_avatar" options="{'size': [90, 90]}"/>
                    
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="e.g. MacBook Pro 16" required="1"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group string="Basic Details">
                            <!-- Read-only auto-generated asset tag -->
                            <field name="asset_tag" readonly="1"/>
                            <field name="serial_number"/>
                            <field name="category_id" required="1"/>
                            <field name="condition"/>
                        </group>
                        <group string="Acquisition &amp; Location">
                            <field name="acquisition_date"/>
                            <!-- Acquisition Cost with descriptive help text -->
                            <field name="acquisition_cost" 
                                   help="For ranking and reports only. Not used for accounting depreciation."/>
                            <field name="location"/>
                            <field name="department_id"/>
                            <!-- Checkbox for shared resource label -->
                            <field name="is_bookable" string="Shared / Bookable Resource"/>
                        </group>
                    </group>
                    
                    <!-- Notebook containing allocation and maintenance history -->
                    <notebook>
                        <page string="Allocation History" name="allocation_history">
                            <!-- Read-only One2many list view showing past assignments -->
                            <field name="allocation_ids" readonly="1">
                                <tree>
                                    <field name="employee_id"/>
                                    <field name="department_id"/>
                                    <field name="expected_return_date"/>
                                    <field name="state" widget="badge"/>
                                </tree>
                            </field>
                        </page>
                        
                        <page string="Maintenance History" name="maintenance_history">
                            <!-- Placeholder tab. Because maintenance model does not exist in python yet, 
                                 we render a placeholder message to prevent Odoo view compilation failures. -->
                            <group>
                                <p class="text-muted">
                                    <i class="fa fa-info-circle me-2"/>
                                    Maintenance history will be visible here once the <strong>assetflow.maintenance</strong> model is fully registered on the backend.
                                </p>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View: Asset Filtering & Grouping -->
    <record id="view_assetflow_asset_search" model="ir.ui.view">
        <field name="name">assetflow.asset.search</field>
        <field name="model">assetflow.asset</field>
        <field name="arch" type="xml">
            <search string="Search Assets">
                <!-- Search text fields -->
                <field name="name" string="Asset Name"/>
                <field name="asset_tag" string="Asset Tag"/>
                <field name="serial_number" string="Serial Number"/>
                <field name="category_id" string="Category"/>
                <field name="location" string="Location"/>
                <field name="department_id" string="Department"/>
                <!-- QR Code search field (assumed to exist on model) -->
                <field name="qr_code" string="QR Code"/>
                
                <!-- Quick Filter status buttons -->
                <filter string="Available" name="filter_available" domain="[('state', '=', 'available')]"/>
                <filter string="Allocated" name="filter_allocated" domain="[('state', '=', 'allocated')]"/>
                <filter string="Under Maintenance" name="filter_maintenance" domain="[('state', '=', 'maintenance')]"/>
                <filter string="Lost" name="filter_lost" domain="[('state', '=', 'lost')]"/>
                
                <separator/>
                
                <!-- Group By options -->
                <group expand="0" string="Group By">
                    <filter string="Category" name="group_by_category" context="{'group_by': 'category_id'}"/>
                    <filter string="Status" name="group_by_status" context="{'group_by': 'state'}"/>
                    <filter string="Department" name="group_by_department" context="{'group_by': 'department_id'}"/>
                    <filter string="Location" name="group_by_location" context="{'group_by': 'location'}"/>
                    <filter string="Condition" name="group_by_condition" context="{'group_by': 'condition'}"/>
                </group>
            </search>
        </field>
    </record>


    <!-- ======================================================================= -->
    <!-- PART B: ALLOCATION & TRANSFER                                           -->
    <!-- ======================================================================= -->

    <!-- Window Action: Asset Allocations -->
    <record id="action_assetflow_allocation" model="ir.actions.act_window">
        <field name="name">Allocations &amp; Transfers</field>
        <field name="res_model">assetflow.allocation</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Assign an asset to an employee.
            </p>
            <p>
                Track who holds which asset and handle department/employee transfer workflows.
            </p>
        </field>
    </record>

    <!-- Tree/List View: Allocations -->
    <record id="view_assetflow_allocation_tree" model="ir.ui.view">
        <field name="name">assetflow.allocation.tree</field>
        <field name="model">assetflow.allocation</field>
        <field name="arch" type="xml">
            <!-- decoration-danger triggers red highlighting for overdue returns -->
            <tree decoration-danger="expected_return_date &lt; current_date and state == 'allocated'">
                <field name="asset_id"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="expected_return_date"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'allocated'"
                       decoration-warning="state == 'requested'"
                       decoration-info="state == 'approved'"
                       decoration-danger="state == 'transfer'"
                       decoration-muted="state == 'returned'"/>
            </tree>
        </field>
    </record>

    <!-- Form View: Allocation & Transfer Details -->
    <record id="view_assetflow_allocation_form" model="ir.ui.view">
        <field name="name">assetflow.allocation.form</field>
        <field name="model">assetflow.allocation</field>
        <field name="arch" type="xml">
            <form string="Asset Allocation">
                <header>
                    <!-- Standard allocation action when asset is available -->
                    <button name="action_allocate" 
                            string="Allocate" 
                            type="object" 
                            class="btn-primary" 
                            invisible="is_currently_allocated or state != 'draft'"/>
                            
                    <!-- Transfer Request triggers if the asset is already held by someone else -->
                    <button name="action_request_transfer" 
                            string="Request Transfer" 
                            type="object" 
                            class="btn-primary" 
                            invisible="not is_currently_allocated or state != 'draft'"/>
                            
                    <!-- Approve Button: restricted to Managers and Department Heads -->
                    <button name="action_approve_transfer" 
                            string="Approve Transfer" 
                            type="object" 
                            class="btn-primary" 
                            invisible="state != 'requested'" 
                            groups="assetflow.group_asset_manager"/>
                            
                    <!-- Complete Re-allocation button -->
                    <button name="action_complete_reallocation" 
                            string="Complete Re-allocation" 
                            type="object" 
                            class="btn-primary" 
                            invisible="state != 'approved'"/>
                            
                    <!-- Return Check-in wizard button -->
                    <button name="action_mark_returned" 
                            string="Mark Returned" 
                            type="object" 
                            class="btn-secondary" 
                            invisible="state != 'allocated'"/>
                            
                    <field name="state" widget="statusbar" statusbar_visible="draft,requested,approved,allocated,returned"/>
                </header>
                
                <sheet>
                    <!-- Hidden fields to drive UI dynamic behavior -->
                    <field name="is_currently_allocated" invisible="1"/>
                    <field name="current_holder_id" invisible="1"/>

                    <!-- Red Warning Banner styled using Design System parameters.
                         Visible only when target asset is currently allocated. -->
                    <div class="alert alert-danger d-flex align-items-center" 
                         role="alert" 
                         invisible="not is_currently_allocated" 
                         style="background-color: #FEE2E2; color: #B91C1C; border: 1px solid #FCA5A5; border-radius: 8px; padding: 12px; margin-bottom: 16px;">
                        <i class="fa fa-exclamation-triangle me-2" style="font-size: 16px;"/>
                        <span>
                            <strong>Warning:</strong> This asset is currently held by 
                            <field name="current_holder_id" readonly="1" class="font-weight-bold" options="{'no_open': True}"/>. 
                            You must request a transfer of ownership.
                        </span>
                    </div>

                    <group>
                        <group string="Asset Selection">
                            <field name="asset_id" required="1"/>
                        </group>
                        <group string="Allocation Targets">
                            <field name="employee_id" required="1"/>
                            <field name="department_id"/>
                            <field name="expected_return_date"/>
                        </group>
                    </group>
                    
                    <group string="Check-in / Check-out Notes">
                        <field name="checkin_notes" placeholder="Specify asset condition check-in comments here upon return..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ======================================================================= -->
    <!-- MENU STRUCTURE INTEGRATION                                              -->
    <!-- ======================================================================= -->

    <!-- Main parent "Assets" menu item under Root -->
    <menuitem id="menu_assetflow_assets_parent" 
              name="Assets" 
              parent="menu_assetflow_root" 
              sequence="20"/>

    <!-- Sub-menu: Asset Directory -->
    <menuitem id="menu_assetflow_asset" 
              name="Asset Directory" 
              parent="menu_assetflow_assets_parent" 
              action="action_assetflow_asset" 
              sequence="10"/>

    <!-- Sub-menu: Allocations & Transfers -->
    <menuitem id="menu_assetflow_allocation" 
              name="Allocations &amp; Transfers" 
              parent="menu_assetflow_assets_parent" 
              action="action_assetflow_allocation" 
              sequence="20"/>

</odoo>
